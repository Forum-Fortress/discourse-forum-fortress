{
  "private": true,
  "devDependencies": {
    "@discourse/lint-configs": "3.2.0",
    "@glint/ember-tsc": "1.8.11",
    "concurrently": "^9.2.3",
    "discourse": "npm:@discourse/types@2026.9.0-cc57a7e8",
    "eslint": "10.6.0",
    "prettier": "3.8.1",
    "stylelint": "17.5.0"
  },
  "scripts": {
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\"",
    "lint:css": "pnpm stylelint 'assets/stylesheets/**/*.scss' --allow-empty-input",
    "lint:js": "eslint {assets,admin/assets,test}/javascripts --cache --no-error-on-unmatched-pattern",
    "lint:prettier": "pnpm prettier 'assets/stylesheets/**/*.scss' '{assets,admin/assets,test}/javascripts/**/*.{js,gjs,ts,gts,mts,cts}' --check --no-error-on-unmatched-pattern",
    "lint:types": "ember-tsc -b",
    "lint:dependencies": "node -e \"if (process.env.FF_PRIVATE_PLUGIN_CI === '1') require('node:child_process').execFileSync(process.execPath, ['--test', 'test/dependency-backports.cjs'], {stdio: 'inherit'})\""
  },
  "engines": {
    "node": ">= 22",
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm",
    "pnpm": "^10"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "overrides": {
      "braces": "file:lib/braces-backport",
      "shell-quote": "^1.11.0",
      "source-map-js": "^1.2.2",
      "postcss-selector-parser": "^7.1.6"
    }
  }
}
